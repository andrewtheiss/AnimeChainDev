rules_version = '2';

// Onboarding data (signup cap + registered-email list) is read and written
// exclusively by the createWallet Cloud Function via the admin SDK, which
// bypasses these rules. No client should ever touch Firestore directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
